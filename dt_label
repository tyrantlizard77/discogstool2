# ── Progress reporting ────────────────────────────────────────────────────────
# When --progress is given, machine-readable events are written to stdout on
# their own lines, each prefixed with _PROGRESS_PREFIX.  dt_server parses these
# to drive the extension's stage display; humans running dt_label directly see
# nothing extra unless they ask for it.  Keeping the events on stdout (rather
# than a side channel) means `dt_label --progress` is trivially debuggable.

_PROGRESS_PREFIX = "@@DTP@@ "
_progress_on = False

# Stage identifiers, in the order the UI displays them.
STAGES = ("lookup", "samples", "bpm", "render", "print")


def emit(stage, state, **fields):
    """Write one progress event, if --progress is active.

    state is one of: "start", "progress", "done", "skip", "error".
    """
    if not _progress_on:
        return
    event = {"stage": stage, "state": state}
    event.update(fields)
    try:
        sys.stdout.write(_PROGRESS_PREFIX + json.dumps(event, ensure_ascii=False) + "\n")
        sys.stdout.flush()
    except Exception:
        pass   # progress reporting must never break a print job


