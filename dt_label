# Order in which fallback faces are tried when the primary lacks a glyph.
_FALLBACK_ORDER = ("cjk", "devanagari", "thai", "arabic", "hebrew", "unicode")

_font_path_cache = {}


def _find_font_path(style):
    if style in _font_path_cache:
        return _font_path_cache[style]
    for path in _FONT_CANDIDATES.get(style, _FONT_CANDIDATES["regular"]):
        if os.path.exists(path):
            _font_path_cache[style] = path
            return path
    _font_path_cache[style] = None
    return None


def make_font(style, size):
    """Return an ImageFont, falling back to Pillow's built-in if needed."""
    path = _find_font_path(style)
    if path:
        return ImageFont.truetype(path, size)
    return ImageFont.load_default()


# Glyph coverage does not depend on point size, so probe once at a fixed size
# and cache the answer per (font path, character).
_PROBE_SIZE = 40

_font_obj_cache = {}    # (path, size) -> ImageFont
_coverage_cache = {}    # (path, char) -> bool
_notdef_cache   = {}    # path -> glyph signature of a guaranteed-absent char
_warned_missing = set() # strings already warned about, to avoid log spam


def _load_font(path, size):
    """Load and cache a TrueType face."""
    key = (path, size)
    font = _font_obj_cache.get(key)
    if font is None:
        font = ImageFont.truetype(path, size)
        _font_obj_cache[key] = font
    return font


def _glyph_sig(font, ch):
    """Rasterise one character; return (size, bytes) or None if it won't render."""
    try:
        mask = font.getmask(ch, mode="1")
    except Exception:
        return None
    return (mask.size, bytes(mask))


def _covers(path, ch):
    """True if the face at `path` has a real glyph for `ch`.

    Works by rasterising the character and comparing it against the face's
    .notdef box, probed with U+FFFE — a permanent noncharacter that no font
    is allowed to map, so it always yields .notdef.  Whitespace is always
    treated as covered.
    """
    if ch.isspace():
        return True
    key = (path, ch)
    cached = _coverage_cache.get(key)
    if cached is not None:
        return cached

    font   = _load_font(path, _PROBE_SIZE)
    notdef = _notdef_cache.get(path)
    if notdef is None:
        notdef = _glyph_sig(font, "￾")
        _notdef_cache[path] = notdef

    sig = _glyph_sig(font, ch)
    ok  = sig is not None and sig != notdef
    _coverage_cache[key] = ok
    return ok


def _missing_chars(path, text):
    """Characters of `text` that the face at `path` cannot render (deduped)."""
    return [ch for ch in dict.fromkeys(text) if not _covers(path, ch)]


def _font_for(style, size, text):
    """Return a font that can actually render `text`.

    Prefers the requested style.  If that face is missing glyphs, walks
    _FALLBACK_ORDER and returns the first face covering the *entire* string —
    whole-string coverage matters because Pillow draws the run in one face, so
    a fallback that fixes the Devanagari but drops the Latin is no better.

    If nothing covers everything, uses whichever face covers the most and warns
    once on stderr about the characters that will print as boxes.
    """
    if not isinstance(text, str) or not text:
        return make_font(style, size)

    primary = _find_font_path(style)
    if primary and not _missing_chars(primary, text):
        return make_font(style, size)

    best_path    = primary
    best_missing = (_missing_chars(primary, text) if primary
                    else list(dict.fromkeys(text)))

    for fb_style in _FALLBACK_ORDER:
        path = _find_font_path(fb_style)
        if not path:
            continue
        missing = _missing_chars(path, text)
        if not missing:
            return _load_font(path, size)
        if best_path is None or len(missing) < len(best_missing):
            best_path, best_missing = path, missing

    if best_missing and text not in _warned_missing:
        _warned_missing.add(text)
        codes = " ".join(f"U+{ord(c):04X}" for c in best_missing)
        print(f"  Warning: no installed font renders {codes} in {text!r}; "
              f"these will print as boxes.", file=sys.stderr)

    if best_path:
        return _load_font(best_path, size)
    return make_font(style, size)


# ── Track grouping ────────────────────────────────────────────────────────────

def get_side(position):
    """Extract the side letter(s) from a position string like 'A1', 'B2', 'AA1'.
    Returns '' for purely numeric positions."""
    if not position:
        return ""
    m = re.match(r"^([A-Za-z]+)", position.strip())
    return m.group(1).upper() if m else ""


def side_to_disc(side):
    """Map a side letter to a disc number.  A/B → 1, C/D → 2, E/F → 3 …
    Multi-letter sides (AA, BB …) map the same way using the first character."""
    if not side:
        return 1
    idx = ord(side[0].upper()) - ord("A")
    return (idx // 2) + 1


def _cd_track_indices(release):
    """Indices of the CD tracks on a vinyl+CD release, which labels leave off.

    Discogs doesn't say which medium a track is on, so this goes by position.
    On a release whose formats include both Vinyl and CD, a track is on the CD
    if its position has no side letter ("1", "12") or starts with "CD"
    ("CD1", "CD-1", "CD1-1").  That covers all five vinyl+CD releases with
    listed CD tracks in a ~1,170-release collection.  Before this, numeric CD tracks joined disc 1
    with A/B, and "CD1" read as side "CD", which side_to_disc() put on
    disc 2 between sides C and D.

    Nothing is dropped unless the release has both formats, so vinyl-only and
    CD-only releases are untouched.  If the rule would leave no vinyl tracks,
    nothing is dropped either: an empty label helps no one, and that would
    mean the rule has misread the tracklist.  CD tracks written with vinyl
    letters ("E1") can't be told apart and stay.
    """
    formats = release.getFormats()
    if not isinstance(formats, list) or not {"Vinyl", "CD"} <= set(formats):
        return set()
    n = release.getTotalTracks()
    cd = set()
    for i in range(n):
        side = get_side(release.getTrack(i)["position"])
        if side == "" or side == "CD":
            cd.add(i)
    return cd if len(cd) < n else set()


def group_tracks_by_disc(release):
    """Return {disc_num: {side_letter: [(global_idx, DiscogsTrack), …]}} preserving order.

    global_idx is the 0-based index into release.getTrack(i), which matches
    the keys returned by BeatportMatcher.find_bpms().  CD tracks on a vinyl+CD
    release are left out (see _cd_track_indices), so neither a normal label nor
    a --split one prints them, and --split counts only the vinyl discs.
    """
    discs = {}
    skip  = _cd_track_indices(release)
    for i in range(release.getTotalTracks()):
        if i in skip:
            continue
        track = release.getTrack(i)
        side  = get_side(track["position"])
        disc  = side_to_disc(side) if side else 1
        discs.setdefault(disc, {}).setdefault(side, []).append((i, track))
    return discs


def flatten_discs(discs):
    """Flatten disc/side groups into [(side_letter, global_idx, DiscogsTrack), …] in order."""
    result = []
    for disc_num in sorted(discs):
        for side in sorted(discs[disc_num]):
            for idx, track in discs[disc_num][side]:
                result.append((side, idx, track))
    return result


# ── Drawing helpers ───────────────────────────────────────────────────────────

def truncate_text(draw, text, font, max_width):
    """Shorten text with a trailing ellipsis so it fits within max_width pixels."""
    if draw.textlength(text, font=font) <= max_width:
        return text
    while text:
        text = text[:-1]
        candidate = text.rstrip() + "\u2026"
        if draw.textlength(candidate, font=font) <= max_width:
            return candidate
    return "\u2026"


# Discogs appends " (2)", " (3)" etc. to disambiguate artists with the same name.
# These are database artefacts and should not appear on printed labels.
# Multi-artist strings are joined with " / " (compileListData), so a suffix
# can sit before a separator as well as at the end: "Caterina Barbieri (2) /
# Donato Dozzy / Lucy (12)".  Matching only at the end left the inner ones on
# the label; truncation used to hide that, wrapping does not.
# Separators themselves are left alone: "Jonsson/Alter" is one duo's name.
_DISAMBIG_RE = re.compile(r'\s*\(\d+\)(?=\s*/|\s*$)')


def _strip_disambig(name: str) -> str:
    """Remove Discogs disambiguation suffixes like ' (2)' from artist name(s)."""
    return _DISAMBIG_RE.sub("", name).strip()


def wrap_text(draw, text, font, max_width, max_lines=2):
    """Wrap *text* at word boundaries into at most *max_lines* lines.

    Returns a list of 1\u2013*max_lines* strings.  The last line is truncated
    with '\u2026' if there is still overflow after filling all available lines.
    """
    if draw.textlength(text, font=font) <= max_width:
        return [text]

    words = text.split(" ")
    lines: list[str] = []
    current: list[str] = []

    for word in words:
        probe = " ".join(current + [word])
        if draw.textlength(probe, font=font) <= max_width:
            current.append(word)
        else:
            if current:
                lines.append(" ".join(current))
            else:
                # A single word is already too wide \u2014 truncate it immediately.
                lines.append(truncate_text(draw, word, font, max_width))
            current = [word] if current else []
            if len(lines) >= max_lines:
                current = []
                break

    if current and len(lines) < max_lines:
        lines.append(" ".join(current))

    if not lines:
        return [truncate_text(draw, text, font, max_width)]

    # Always truncate the last line in case it is still too long.
    lines[-1] = truncate_text(draw, lines[-1], font, max_width)
    return lines


def hline(draw, y, x0, x1, color="black", weight=2):
    draw.line([(x0, y), (x1, y)], fill=color, width=weight)


# ── Credits ───────────────────────────────────────────────────────────────────

# Which Discogs roles are printed, and as what.  A label has room for the
# credits that tell you *which version* is on the record and who is on it —
# not the pressing and packaging credits (Lacquer Cut By, Mastered By, Artwork)
# that dominate release-level credits on Discogs.  Chosen from a tally of the
# roles in a 1000-release collection: Remix is by far the most common track
# credit, then Producer, Featuring and Vocals.
#
# Rules are tried in order; the first whose base role matches and whose
# qualifier pattern matches (None = any qualifier, or none) decides.  A None
# label excludes the role.
_CREDIT_RULES = (
    # base role      qualifier pattern        printed as
    ("Remix",        None,                    "Remix"),
    ("Edited By",    r"digital",              None),     # mastering-side editing, not a re-edit
    ("Edited By",    None,                    "Edit"),
    ("DJ Mix",       None,                    "DJ Mix"),
    ("Featuring",    None,                    "Featuring"),
    ("Vocals",       r"background|backing",   None),
    ("Vocals",       None,                    "Vocals"),
    ("Lead Vocals",  None,                    "Vocals"),
    ("Voice",        None,                    "Voice"),
    ("Producer",     r"^additional",          "Add. Production"),
    ("Producer",     None,                    "Producer"),
    ("Co-producer",  None,                    "Co-producer"),
)

# Print order within a credit line: version first, then who is on it, then
# who made it.
_CREDIT_ORDER = ("Remix", "Edit", "DJ Mix", "Featuring", "Vocals", "Voice",
                 "Producer", "Co-producer", "Add. Production")

# Credits that identify *which version* of a track this is.  These print even
# when they name the track's own artist — see _track_credits().
_VERSION_LABELS = frozenset({"Remix", "Edit", "DJ Mix"})

_ROLE_QUALIFIER_RE = re.compile(r"^(.*?)\s*(?:\[(.*)\])?\s*$")


def _credit_label(role):
    """Printed label for one Discogs role ("Remix [Reshaped]" → "Remix"), or None."""
    m = _ROLE_QUALIFIER_RE.match(role or "")
    base, qualifier = m.group(1).strip(), (m.group(2) or "").strip()
    for rule_base, qual_pat, label in _CREDIT_RULES:
        if base.casefold() != rule_base.casefold():
            continue
        if qual_pat is None or (qualifier and re.search(qual_pat, qualifier, re.I)):
            return label
    return None


def _track_credits(release, track):
    """[(label, name), …] to print under one track's row.

    Only the track's own Discogs credits — the ones shown under it in the
    tracklist.  Release credits are left off entirely, even ones scoped to
    this track: on the label they were mostly the producer under an alias or
    real name ("Producer [Uncredited]: Brenton Smith" on Daze, r6628547),
    which says nothing about the record in your hand.

    Two filters keep a row from saying things twice:

    * A credit whose name is already in the track title is dropped.  Discogs
      titles usually carry the remixer — "Peels A Tangerine (Regis Remix)"
      with "Remix: Regis" — and across a 1000-release collection 74% of Remix
      credits were redundant this way.
    * A credit naming the release's or the track's own artist is dropped —
      "Producer: <the artist>" says nothing.  Version credits
      (_VERSION_LABELS) are exempt: an artist remixing their own track is
      exactly what tells two versions apart.

    Stub tracks (the tests use MagicMock) yield no credits.
    """
    credits = track.getTrackCredits()
    if not isinstance(credits, list) or not credits:
        return []

    own_ids = set(release.getArtistIds()) | set(track.getArtistIds())
    title = track.getTitle(synthesise=False)
    pairs = []
    for c in credits:
        label = _credit_label(c["role"])
        name  = _strip_disambig(c["name"])
        if not label or not name:
            continue
        if (label not in _VERSION_LABELS
                and c["artist_id"] and c["artist_id"] in own_ids):
            continue
        if _named_in(name, title):
            continue
        if (label, name) not in pairs:
            pairs.append((label, name))
    return pairs


def _named_in(name, text):
    """True if *name* appears in *text* as a whole word or phrase, any case.

    Word-bounded so "Regis" matches "(Regis Remix)" but a short name doesn't
    match inside an unrelated word.
    """
    if not isinstance(text, str) or not text:
        return False
    return re.search(r"(?<!\w)" + re.escape(name) + r"(?!\w)", text,
                     re.IGNORECASE) is not None


_CREDIT_SEP = " \u00b7 "


def _credit_groups(pairs):
    """[(label, name), …] → ["Remix: A, B", "Vocals: C"] in _CREDIT_ORDER."""
    names = {}
    for label, name in pairs:
        names.setdefault(label, []).append(name)
    return [f"{label}: {', '.join(names[label])}"
            for label in _CREDIT_ORDER if label in names]


def _format_credits(pairs):
    """[(label, name), …] → "Remix: A, B · Vocals: C"."""
    return _CREDIT_SEP.join(_credit_groups(pairs))


def wrap_credits(draw, groups, font, max_width, max_lines=2):
    """Lay out credit groups into at most *max_lines* lines.

    Breaks fall between groups, so a role label is never separated from its
    names ("Add. Production:" / "Goran Simonoski").  A single group wider than
    a whole line is word-wrapped on its own.  If groups are left over when the
    lines run out, the last line ends in an ellipsis so it is clear the list
    was cut, not complete.
    """
    lines = []
    current = ""
    placed = 0
    for group in groups:
        candidate = f"{current}{_CREDIT_SEP}{group}" if current else group
        if draw.textlength(candidate, font=font) <= max_width:
            current = candidate
            placed += 1
            continue
        if current:
            lines.append(current)
            current = ""
        if len(lines) >= max_lines:
            break
        if draw.textlength(group, font=font) <= max_width:
            current = group
        else:
            pieces = wrap_text(draw, group, font, max_width,
                               max_lines=max_lines - len(lines))
            lines.extend(pieces[:-1])
            current = pieces[-1]
        placed += 1
    if current and len(lines) < max_lines:
        lines.append(current)

    if lines and placed < len(groups):
        lines[-1] = truncate_text(draw, lines[-1] + " \u2026", font, max_width)
    return lines


# ── Label rendering ───────────────────────────────────────────────────────────

def _resolve_track_text(track, track_idx, is_compilation, bpms=None):
    """Return the exact string rendered for one track row, duration included.

    This is the single source of truth for what a row contains.  The height
    calculation and the renderer must agree on it exactly: if one appends a
    duration the other doesn't know about, the extra text can push a title onto
    a second line, the predicted canvas comes up short, and the bottom-anchored
    QR code lands on top of the track listing.  That is precisely how the
    Beatport duration fallback misplaced the QR on r4884361.

    Returns None for stub/mock tracks whose title isn't a string.
    """
    if is_compilation:
        title = track.getTitle(synthesise=False)
        if not isinstance(title, str):
            return None
        text = f"{_strip_disambig(track.getArtist())} – {title}"
    else:
        text = track.getTitle(synthesise=False)
        if not isinstance(text, str):
            return None

    # Prefer the Discogs duration; fall back to Beatport's length_ms.
    dur = track.getDuration()
    if not dur:
        info = (bpms or {}).get(track_idx) or {}
        ms = info.get("duration_ms")
        if ms:
            secs = ms // 1000
            dur = f"{secs // 60}:{secs % 60:02d}"

    return text + (f" ({dur})" if dur else "")


# Gap + divider drawn between the track listing and the notes area.
# Mirrors the `y += 10; hl(y); y += 18` at the top of the notes section.
_NOTES_GAP = 28


def _layout_height(release, tracks_with_sides, profile, is_compilation,
                   continuation=False, disc_info=None, bpms=None):
    """Canvas height for a continuous label, measured from a real layout pass.

    This used to be predicted by a second implementation of the layout
    (_continuous_height + _measure_wrap_extra_px) that re-derived header,
    side-header and wrapped-line heights from constants.  Keeping two
    implementations in agreement failed three separate times — most recently
    when the renderer appended a Beatport duration the measurer knew nothing
    about, wrapping two titles and printing the QR over the track listing.

    Now the height comes from running render_label itself in probe mode, so
    there is exactly one layout implementation and nothing to drift.

    Raises ValueError if the result exceeds the 12" sleeve limit.
    """
    content_bottom = render_label(
        release, tracks_with_sides, profile, is_compilation,
        continuation=continuation, disc_info=disc_info, bpms=bpms,
        probe=True,
    )

    # The QR is bottom-anchored at H - M - _QR_SIZE, so the canvas must leave
    # exactly that much below the content for it to clear the last track row.
    height = content_bottom + _NOTES_GAP + _QR_SIZE + profile["margin_px"]

    if height > MAX_CONTINUOUS_PX:
        raise ValueError(
            f"Label would be {height/300:.2f}\" tall — exceeds the 12\" sleeve limit.\n"
            f"Use --split to print one label per disc."
        )
    return height


def _position_column_width(draw, font, tracks_with_sides):
    """Width of the position column, sized to the widest position present.

    Usually a short side/track label ("A1", "B12"), but some releases use
    timestamps ("14:03" on a continuous DJ mix) or double-letter sides ("AA1").
    A fixed width let those run straight into the title text — see r34333258.

    Non-string positions (stub tracks in tests) are skipped rather than
    measured.
    """
    widest = 0.0
    for _side, _idx, track in tracks_with_sides:
        try:
            pos = track["position"]
        except Exception:
            continue
        if isinstance(pos, str) and pos:
            widest = max(widest, draw.textlength(pos, font=font))
    # ceil, not int: truncating left the column a fraction of a pixel
    # short of the widest string, which is still a collision.
    return max(_POS_W_MIN, math.ceil(widest) + _POS_W_GAP)


def render_label(release, tracks_with_sides, profile,
                 is_compilation, continuation=False, disc_info=None,
                 height_px=None, notes_lines=None, bpms=None, probe=False):
    """Render and return a single PIL Image for one label.

    Args:
        release:           DiscogsRelease instance
        tracks_with_sides: [(side_letter, global_idx, DiscogsTrack), …]
        profile:           label size profile dict
        is_compilation:    show per-track artists when True
        continuation:      compact header for overflow continuation labels
        disc_info:         (disc_num, total_discs) for --split mode, else None
        height_px:         override canvas height (continuous labels only)
        notes_lines:       fixed note line count; None = fill remaining space
        bpms:              {global_track_idx: bpm_int} from BeatportMatcher,
                           or None/empty to show blank write zones for all tracks
        probe:             lay out the header and tracks but draw nothing
                           permanent; return the y of the content bottom
                           instead of an Image.  Used by _layout_height() so
                           the canvas size is *measured* from a real layout
                           rather than predicted by a parallel implementation.

    Returns a PIL Image, or an int content-bottom y when probe=True.
    """
    W  = profile["width_px"]
    M  = profile["margin_px"]
    CW = W - 2 * M   # usable content width

    # Content layout never depends on H — only the bottom-anchored QR and the
    # die-cut ruled-line fill do, and neither runs in probe mode.  So a probe
    # can use a 1px-tall scratch canvas: Pillow clips the draw calls and the
    # arithmetic is identical to a full render.
    if probe:
        H = 1
    else:
        H = height_px if height_px is not None else profile["height_px"]

    img  = Image.new("RGB", (W, H), "white")
    draw = ImageDraw.Draw(img)

    # Fonts (sizes in points; 1pt ≈ 4.17px at 300 DPI)
    f_meta      = make_font("regular",   32)
    f_side_hdr  = make_font("bold",      28)
    f_pos       = make_font("bold",      38)
    f_track     = make_font("regular",   38)
    f_notes_hdr = make_font("bold",      28)

    BPM_ZONE_W  = 110                         # right-side blank area for handwritten BPM
    # Position column: usually a short side/track label ("A1", "B12"), but some
    # releases use timestamps ("14:03" on a continuous DJ mix) or double-letter
    # sides ("AA1").  A fixed width let those run straight into the title text,
    # so measure the widest one actually present and size the column to it.
    # Computed here rather than by a caller so probe and render always agree —
    # POS_W feeds TITLE_MAX_W, which decides wrapping, which decides height.
    POS_W       = _position_column_width(draw, f_pos, tracks_with_sides)
    TITLE_MAX_W = CW - POS_W - BPM_ZONE_W - 16

    # Continuous labels auto-size their canvas; die-cut labels have a fixed canvas.
    # Wrapping is only enabled for continuous labels — die-cut labels truncate instead,
    # because their canvas cannot grow to accommodate extra line height.
    is_continuous = profile.get("feed") == "continuous"

    x0 = M
    x1 = W - M
    y  = M

    def hl(y_pos, color="black", weight=2):
        hline(draw, y_pos, x0, x1, color=color, weight=weight)

    # ── Header ───────────────────────────────────────────────────────────────

    if continuation:
        # Minimal header: artist — title  (continued)
        hdr = f"{_strip_disambig(release.getArtist()).upper()} \u2014 {release.getTitle()}  (continued)"
        f_hdr = _font_for("regular", 32, hdr)
        draw.text((M, y), truncate_text(draw, hdr, f_hdr, CW), font=f_hdr, fill="black")
        y += 46
    else:
        # Artist (large bold caps) and release title both wrap rather than
        # truncate.  The font is chosen from the whole string *before*
        # wrapping, so the line breaks are measured in the face that is drawn.
        # Discogs "(N)" disambiguation suffixes are stripped from the artist.
        for text, style in ((_strip_disambig(release.getArtist()).upper(), "bold"),
                            (release.getTitle(), "regular")):
            f_hdr = _font_for(style, 54, text)
            lines = wrap_text(draw, text, f_hdr, CW, max_lines=_HEADER_MAX_LINES)
            for i, line in enumerate(lines):
                draw.text((M, y), line, font=f_hdr, fill="black")
                # 58 px between wrapped lines; 70 px after the final line.
                y += _TITLE_WRAP_LINE_H if i < len(lines) - 1 else 70

        # Disc indicator for --split labels (immediately below title)
        if disc_info:
            disc_num, total_discs = disc_info
            draw.text((M, y), f"Disc {disc_num} of {total_discs}", font=f_meta, fill="#555555")
            y += 40

        y += 10
        hl(y); y += 18

        # Label [catno]                          Year  Country
        # Either can be empty — r3060397 lists no label at all — so join only
        # what is there rather than printing a bare "  []".
        catno      = release.getCatno()
        label_meta = "  ".join(part for part in
                               (release.getLabel(), f"[{catno}]" if catno else "")
                               if part)
        # Same for year and country: Discogs leaves country null on ~1% of
        # releases, and a trailing "  " would pull the right-aligned year in
        # from the margin.
        year_cc    = "  ".join(part for part in
                               (release.getLabelYear(), release.getCountry())
                               if part)
        ycc_w = draw.textlength(year_cc, font=f_meta)
        label_meta = truncate_text(draw, label_meta, f_meta, CW - ycc_w - 24)
        draw.text((M, y), label_meta, font=f_meta, fill="black")
        draw.text((W - M - ycc_w, y), year_cc, font=f_meta, fill="black")
        y += 46

        # Genre / styles                                        [rXXXXXXXX]
        rid_str = f"[r{release.getId()}]"
        rid_w   = draw.textlength(rid_str, font=f_meta)
        genre_str = truncate_text(draw, release.getGenre(), f_meta, CW - rid_w - 16)
        draw.text((M, y), genre_str, font=f_meta, fill="black")
        draw.text((W - M - rid_w, y), rid_str, font=f_meta, fill="#777777")
        y += 46

    y += 8
    hl(y); y += 18

    # ── Track listing ─────────────────────────────────────────────────────────

    current_side = object()   # sentinel — guaranteed != any real side string
    bpms = bpms or {}

    f_bpm = make_font("bold", 34)   # slightly smaller than track font for BPM values

    # Pre-compute track text height so we can bottom-align it with the BPM line
    _track_text_h = f_track.getbbox("Ag")[3]

    for side, track_idx, track in tracks_with_sides:

        # Side header when the side changes
        if side != current_side:
            current_side = side
            side_label = f"Side {side}" if side else "Tracks"
            draw.text((M, y), side_label, font=f_side_hdr, fill="black")
            y += _SIDE_HDR_H - 10
            hl(y, color="#AAAAAA", weight=1)
            y += 10

        pos = track["position"] or ""

        # Row text, including any duration suffix.  Shared with the height
        # calculation via _resolve_track_text so the two can never disagree
        # about what is being laid out.
        full_track_str = _resolve_track_text(track, track_idx,
                                             is_compilation, bpms) or ""

        # Pick a script-capable font if the track title requires it.
        f_track_r = _font_for("regular", 38, full_track_str)

        # Continuous labels: wrap to at most 2 lines (canvas grows to fit).
        # Die-cut labels: truncate only — canvas height is fixed and cannot grow.
        if is_continuous:
            title_lines = wrap_text(draw, full_track_str, f_track_r, TITLE_MAX_W)
        else:
            title_lines = [truncate_text(draw, full_track_str, f_track_r, TITLE_MAX_W)]

        # Credits for this track in a smaller face under the title.  Same wrap
        # policy as the title, and the same width, so they stay clear of the
        # BPM zone.
        credit_groups = _credit_groups(_track_credits(release, track))
        credit_lines = []
        if credit_groups:
            f_credit_r = _font_for("regular", _CREDIT_FONT_PX,
                                   _CREDIT_SEP.join(credit_groups))
            credit_lines = wrap_credits(draw, credit_groups, f_credit_r,
                                        TITLE_MAX_W,
                                        max_lines=2 if is_continuous else 1)
        credits_h = len(credit_lines) * _CREDIT_LINE_H

        row_h      = (_TRACK_ROW_H + (len(title_lines) - 1) * _EXTRA_LINE_H
                      + credits_h)
        bpm_line_y = y + row_h - 18
        # text_y aligns the *first* title line (and the position number) with the
        # bottom-anchor point, leaving room below for any extra wrapped lines
        # and the credit lines.
        text_y = (bpm_line_y - _track_text_h
                  - (len(title_lines) - 1) * _EXTRA_LINE_H - credits_h)

        draw.text((M, text_y), pos, font=f_pos, fill="black")
        for line_i, line in enumerate(title_lines):
            draw.text((M + POS_W, text_y + line_i * _EXTRA_LINE_H),
                      line, font=f_track_r, fill="black")

        credit_y = text_y + (len(title_lines) - 1) * _EXTRA_LINE_H + _track_text_h + 4
        for line_i, line in enumerate(credit_lines):
            draw.text((M + POS_W, credit_y + line_i * _CREDIT_LINE_H),
                      line, font=f_credit_r, fill="#444444")

        # BPM zone: print value if known, otherwise leave a blank write zone.
        _track_info = bpms.get(track_idx) or {}
        known_bpm   = _track_info.get("bpm")
        if known_bpm:
            bpm_str = str(known_bpm)
            bpm_w = draw.textlength(bpm_str, font=f_bpm)
            bpm_x = W - M - (BPM_ZONE_W + bpm_w) // 2  # centre in zone
            draw.text((bpm_x, text_y), bpm_str, font=f_bpm, fill="#333333")
            # Faint underline to show the write zone even with a printed value
            hline(draw, bpm_line_y, W - M - BPM_ZONE_W, W - M, color="#BBBBBB", weight=1)
        else:
            hline(draw, bpm_line_y, W - M - BPM_ZONE_W, W - M, color="#888888", weight=3)

        y += row_h

    # ── Notes section ─────────────────────────────────────────────────────────

    # Everything above this point is the content whose height must be known
    # before a canvas can be sized.  A probe stops here and reports it.
    if probe:
        return y

    y += 10
    hl(y); y += 18

    # QR code sits flush in the bottom-left corner of the notes area.
    # Ruled lines that enter the QR zone start to the right of it.
    # qr_top is anchored to the canvas bottom so the QR is never clipped;
    # _layout_height() sized the canvas from a real layout pass so the content
    # above is guaranteed to clear it.
    qr_top  = H - M - _QR_SIZE
    qr_left = M

    # Self-check: the canvas height was predicted before rendering, so if the
    # prediction came up short the bottom-anchored QR lands on the tracks.
    # This has been the cause of every QR misplacement so far, and it used to
    # fail silently — a wrong label you only notice after it prints.  Surface
    # it instead.  `y` is the notes divider, i.e. the true content bottom.
    if y > qr_top:
        log.warning(
            "label layout: content overruns the QR zone by %d px "
            "(content bottom %d, qr_top %d) — predicted canvas height %d is "
            "too short; the QR will overlap the track listing.",
            y - qr_top, y, qr_top, H,
        )

    def _hl_notes(line_y):
        x_left = qr_left + _QR_SIZE + 8 if line_y >= qr_top else M
        hline(draw, line_y, x_left, W - M, color="#DDDDDD", weight=1)

    if notes_lines is not None:
        # Continuous labels: fixed number of ruled lines (all within QR zone)
        for _ in range(notes_lines):
            y += _LINE_SPACING
            _hl_notes(y)
    else:
        # Die-cut labels: fill remaining space
        while y + _LINE_SPACING < H - M:
            y += _LINE_SPACING
            _hl_notes(y)

    # Generate QR code linking to the Discogs release page
    qr = qrcode.QRCode(
        error_correction=qrcode.constants.ERROR_CORRECT_L,
        box_size=6,
        border=1,
    )
    qr.add_data(f"https://discogs.com/release/{release.getId()}")
    qr.make(fit=True)
    qr_img = qr.make_image(fill_color="black", back_color="white").convert("RGB")
    qr_img = qr_img.resize((_QR_SIZE, _QR_SIZE), Image.NEAREST)
    img.paste(qr_img, (qr_left, qr_top))

    return img


def _chunk_tracks(all_tracks, profile, release, is_compilation=False,
                  bpms=None, disc_info=None):
    """Pack tracks greedily onto labels by *measured* height.

    Continuous labels fill up to MAX_LABEL_HEIGHT_PX.  Die-cut labels fill up
    to their fixed canvas, with the QR still clearing the last row, and never
    take more than the profile's max_tracks.

    Die-cut used to be packed by count alone — max_tracks per label — which
    assumed every row was one line and every label had two sides.  Across a
    1000-release collection that already overran the QR zone on 48 labels
    (by up to 148 px: four side headers, a two-line title), before credit lines
    made rows taller still.

    Returns a list of track-chunks.  The first chunk uses the normal (tall)
    header; subsequent chunks use the compact continuation header — so their
    heights are calculated accordingly.

    `release` is required: heights come from a real layout pass, which renders
    the header, so there is nothing to measure without it.  `disc_info` is
    passed for --split labels, whose first chunk carries a "Disc N of M" line.
    """
    if profile.get("feed") == "continuous":
        limit, cap = MAX_LABEL_HEIGHT_PX, None
    else:
        limit, cap = profile["height_px"], profile["max_tracks"]

    def fits(tracks, continuation):
        if cap is not None and len(tracks) > cap:
            return False
        try:
            h = _layout_height(release, tracks, profile, is_compilation,
                               continuation=continuation, bpms=bpms,
                               disc_info=None if continuation else disc_info)
        except ValueError:
            return False   # exceeds the 12" hard limit
        return h <= limit

    chunks    = []
    remaining = list(all_tracks)

    while remaining:
        continuation = bool(chunks)

        # Check whether all remaining tracks fit on this label.
        if fits(remaining, continuation):
            chunks.append(remaining)
            break

        # Binary search for the largest prefix that fits.
        lo, hi = 1, len(remaining) - 1
        while lo < hi:
            mid = (lo + hi + 1) // 2
            if fits(remaining[:mid], continuation):
                lo = mid
            else:
                hi = mid - 1

        take = max(lo, 1)   # always advance by at least one track
        chunks.append(remaining[:take])
        remaining = remaining[take:]

    return chunks


def _render_kwargs(tracks, profile, continuation=False, disc_info=None,
                   release=None, is_compilation=False, bpms=None):
    """Return extra kwargs for render_label based on feed type.

    `bpms` must match what is passed to render_label — duration suffixes affect
    wrapping, and therefore the canvas height the QR is anchored to.
    """
    if profile.get("feed") == "continuous":
        h = _layout_height(release, tracks, profile, is_compilation,
                           continuation=continuation, disc_info=disc_info,
                           bpms=bpms)
        return {"height_px": h, "notes_lines": profile.get("notes_lines", 3)}
    return {}


def render_labels_for_release(release, args, profile, bpms=None):
    """Return [(filename_suffix, PIL.Image), …] for all labels to produce.

    Args:
        bpms: {global_track_idx: bpm_int} from BeatportMatcher, or None.
    """
    is_compilation = release.isCompilation()
    discs          = group_tracks_by_disc(release)
    labels         = []
    bpms           = bpms or {}

    if args.split:
        # One label per disc — plus a continuation if a disc doesn't fit, which
        # previously printed the QR over its last rows (six die-cut discs in a
        # 1000-release collection).  Continuations are "disc2_cont1": "_" sorts
        # after ".", so disc2_cont1.png lists after disc2.png in previews.
        total_discs = len(discs)
        for disc_num in sorted(discs):
            disc_tracks = []
            for side in sorted(discs[disc_num]):
                for idx, track in discs[disc_num][side]:
                    disc_tracks.append((side, idx, track))
            disc_info = (disc_num, total_discs)
            chunks = _chunk_tracks(disc_tracks, profile, release,
                                   is_compilation=is_compilation, bpms=bpms,
                                   disc_info=disc_info)
            for k, chunk in enumerate(chunks):
                cont = k > 0
                kw = _render_kwargs(chunk, profile, continuation=cont,
                                    disc_info=None if cont else disc_info,
                                    release=release,
                                    is_compilation=is_compilation, bpms=bpms)
                img = render_label(release, chunk, profile, is_compilation,
                                   continuation=cont,
                                   disc_info=None if cont else disc_info,
                                   bpms=bpms, **kw)
                suffix = f"disc{disc_num}" + (f"_cont{k}" if cont else "")
                labels.append((suffix, img))

    else:
        # Chunk all tracks into primary + continuation labels, packed by
        # measured height for both feeds (continuous: up to 11.5"; die-cut:
        # its fixed canvas, capped at max_tracks).
        chunks = _chunk_tracks(flatten_discs(discs), profile, release,
                               is_compilation=is_compilation, bpms=bpms)
        for idx, chunk in enumerate(chunks):
            suffix = "label" if idx == 0 else f"cont{idx}"
            kw = _render_kwargs(chunk, profile, continuation=(idx > 0),
                                release=release, is_compilation=is_compilation,
                                bpms=bpms)
            img = render_label(release, chunk, profile,
                               is_compilation, continuation=(idx > 0),
                               bpms=bpms, **kw)
            labels.append((suffix, img))

    return labels


def _select_discs(labels, discs):
    """Keep the --split labels for the requested disc numbers.

    A disc's continuation labels ("disc2_cont1") go with it — matching the
    suffix exactly would print a disc's first label and silently drop the rest.
    """
    want = {f"disc{d}" for d in discs}
    return [(s, img) for s, img in labels if s.split("_")[0] in want]


# ── Printing ──────────────────────────────────────────────────────────────────

# How long to wait for the printer to report completion after the raster data
# Timeouts for talking to the printer.
#
# The send timeout is NOT a network-latency budget — it is "how long may the
# printer take to accept an entire label".  A QL printer accepts raster into a
# small buffer and drains it as it physically prints, so TCP backpressure keeps
# the write blocked for roughly as long as printing takes.  brother_ql's network
# backend hardcodes 10s in its own _write(), which is shorter than a long
# continuous label takes to print — so a queued batch would reliably time out
# partway through, leaving the printer holding a half-received job.  That is why
# the next label then came out as static.
#
# We therefore drive the socket ourselves rather than going through
# BrotherQLBackendNetwork: it exists only to wrap connect+sendall (its readback
# is unusable here, see above), and it gives no way to override that 10s.
#
# Both are overridable in ~/.discogstool/label_config as connect_timeout and
# send_timeout.
_CONNECT_TIMEOUT = 10.0     # establishing the TCP connection
_SEND_TIMEOUT    = 300.0    # writing a whole label, incl. time spent printing

_DEFAULT_PRINTER_PORT = 9100


def _parse_printer_url(printer_url):
    """Split 'tcp://host:9100' (or 'host') into (host, port)."""
    target = printer_url
    if "://" in target:
        target = target.split("://", 1)[1]
    target = target.rstrip("/")
    host, sep, port = target.partition(":")
    return host, int(port) if sep and port else _DEFAULT_PRINTER_PORT


def _send_raster(instructions, printer_url, connect_timeout=None,
                 send_timeout=None):
    """Write raster instructions to the printer over TCP.

    There is deliberately no completion readback: the QL-1110NWB was probed for
    10s on port 9100 and returned zero bytes, so "sent" is the last observable
    step.  (The probe lives in git history — see _send_and_await/probe_printer.)

    Because the write blocks while the printer drains its buffer, a completed
    sendall is a reasonable proxy for "the printer has taken the whole label",
    which is also what paces a queue of jobs.

    Raises OSError/TimeoutError if the connection or the write fails.
    """
    host, port = _parse_printer_url(printer_url)
    connect_timeout = _CONNECT_TIMEOUT if connect_timeout is None else connect_timeout
    send_timeout    = _SEND_TIMEOUT    if send_timeout    is None else send_timeout

    sock = socket.create_connection((host, port), timeout=connect_timeout)
    try:
        # Raster is one big write; Nagle would only add latency.
        sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
        sock.settimeout(send_timeout)
        sock.sendall(instructions)
    finally:
        try:
            sock.close()
        except OSError:
            pass


# Recovery sequence for a printer left mid-raster by a failed send.
#
# This is the same preamble brother_ql's convert() puts at the head of every
# job: 200 null bytes ("invalidate", which clears the command buffer) followed
# by ESC @ ("initialize").  Nulls are no-ops in command mode, and if the printer
# is still waiting on raster data they are consumed as blank pixels — so the
# worst case is a short blank feed rather than the sheet of static you get from
# sending a fresh job to a wedged printer.
#
# Best-effort: the printer never acknowledges anything over 9100, so a
# successful write means only that it accepted the bytes.
_RESET_SEQUENCE = b"\x00" * 200 + b"\x1B\x40"


def reset_printer(printer_url, timeout=10.0):
    """Try to flush a printer holding a partial job.  Returns True if sent."""
    try:
        _send_raster(_RESET_SEQUENCE, printer_url,
                     connect_timeout=timeout, send_timeout=timeout)
        log.debug("printer reset sequence sent to %s", printer_url)
        return True
    except (OSError, TimeoutError) as e:
        log.warning("printer reset failed: %s", e)
        return False


def print_label(img, printer_url, model, profile, retries=3, retry_delay=5,
                progress=None):
    """Send a rendered label image to the Brother printer over the network.

    Retries up to `retries` times on network errors, waiting `retry_delay`
    seconds between attempts.  Raises RuntimeError on final failure.

    A retry re-sends the whole job.  If the printer has already consumed part
    of a previous attempt it will interpret the resend's header bytes as raster
    data and emit a garbage label, so retries are only attempted when nothing
    was written (see `_written` below).

    Nothing is returned: the printer does not report completion over the
    network, so a successful write is as much as can be known.
    """
    from brother_ql.conversion import convert
    from brother_ql.raster import BrotherQLRaster

    qlr = BrotherQLRaster(model)
    instructions = convert(
        qlr,
        images=[img],
        label=profile["brother_ql_id"],
        rotate="0",
        threshold=70,
        dither=False,
        compress=False,
        red=False,
        dpi_600=False,
        cut=True,
    )

    for attempt in range(1, retries + 1):
        try:
            _send_raster(instructions, printer_url)
            return
        except (TimeoutError, OSError) as e:
            # A failure partway through sendall() may have left the printer
            # mid-raster; resending would produce a garbage label.  Only retry
            # when the connection never got established.
            if isinstance(e, ConnectionError) or not _partially_written(e):
                if attempt < retries:
                    print(f"\n  Network error ({e}); retrying in {retry_delay}s "
                          f"(attempt {attempt}/{retries})…", flush=True)
                    time.sleep(retry_delay)
                    continue

            # The write died partway through, so the printer is holding an
            # incomplete job.  Anything sent next — the following queued label,
            # or a manual reprint — would be read as the missing raster and
            # printed as static.  Flush it before giving up.
            recovered = False
            if _partially_written(e):
                print("\n  Send failed mid-transfer; resetting printer…",
                      flush=True)
                recovered = reset_printer(printer_url)

            hint = ("  Printer buffer flushed; the next label should print "
                    "normally.\n"
                    if recovered else
                    "  Could not reach the printer to reset it — power-cycle it "
                    "to clear the buffer,\n  or the next label may print as "
                    "static.\n")
            raise RuntimeError(
                f"Printer send failed: {e}\n"
                "  Check that the printer is on, not in an error state "
                "(solid green LED), and reachable on the network.\n"
                + hint
            ) from e


def _partially_written(exc):
    """Heuristic: did this exception occur after some bytes reached the printer?

    A connection-establishment failure is safe to retry.  A timeout during
    sendall() is not, because the printer may be holding a half-received job.
    """
    return isinstance(exc, (TimeoutError, socket.timeout))


