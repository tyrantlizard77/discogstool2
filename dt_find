#!/usr/bin/env python3
"""dt_find — voice/text vinyl record finder powered by Claude.

Describe a record in plain English — vague, informal, partial — and Claude
searches Discogs on your behalf, opens the release page for confirmation,
then optionally prints a sleeve label.

Usage
-----
    ./dt_find                              # voice input (default)
    ./dt_find --text                       # force typed description
    ./dt_find "the blue Miles Davis one"   # description inline
    ./dt_find --model claude-haiku-4-5-20251001   # pin a model (saved)

Saved settings  (~/.discogstool/find_config)
--------------------------------------------
    find_anthropic_model=claude-haiku-4-5-20251001  # optional model override

The API key is read from ~/.discogstool/beatport_auth.json
("anthropic_api_key") or the ANTHROPIC_API_KEY environment variable.

Voice dependencies (installed separately, see requirements.txt):
    pip install sounddevice SpeechRecognition
"""

from __future__ import annotations

import json
import logging
import os
import subprocess
import sys
import webbrowser

# Allow importing sibling modules
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

import util
import client_interface

log = logging.getLogger(__name__)

# ── Config ─────────────────────────────────────────────────────────────────────

CONFIG_FILE = "find_config"

# Max LLM tool-calling rounds before giving up
MAX_SEARCH_TURNS = 8

# How many Discogs search results to return to the LLM per query
RESULTS_PER_SEARCH = 8


def load_config() -> dict:
    return util.load_kv_config(util.userfile(CONFIG_FILE))


def save_config(config: dict) -> None:
    util.save_kv_config(util.userfile(CONFIG_FILE), config,
                        header="dt_find configuration — auto-updated")


# ── Voice input ────────────────────────────────────────────────────────────────

def record_until_enter(sample_rate: int = 16000) -> "numpy.ndarray | None":
    """Record from the default mic until the user presses Enter.

    Returns a 1-D int16 numpy array, or None on failure.
    Requires: sounddevice, numpy.
    """
    try:
        import sounddevice as sd
        import numpy as np
    except ImportError as e:
        raise SystemExit(
            f"Voice input requires: pip install sounddevice\nMissing: {e}"
        )

    import numpy as np  # ensure it's available in scope below
    chunks: list = []

    def _cb(indata, frames, time, status):  # noqa: ARG001
        chunks.append(indata.copy())

    print("  🎤  Listening… press Enter when done speaking.")
    with sd.InputStream(samplerate=sample_rate, channels=1, dtype="int16",
                        callback=_cb):
        input()  # block until Enter

    if not chunks:
        return None
    return np.concatenate(chunks).flatten()


def transcribe_audio(audio_array: "numpy.ndarray", sample_rate: int = 16000) -> str | None:
    """Transcribe a numpy int16 audio array using macOS on-device speech recognition.

    Requires: SpeechRecognition.
    """
    try:
        import speech_recognition as sr
    except ImportError as e:
        raise SystemExit(
            f"Transcription requires: pip install SpeechRecognition\nMissing: {e}"
        )

    r = sr.Recognizer()
    audio_data = sr.AudioData(audio_array.tobytes(), sample_rate, 2)
    print("  Transcribing…", end=" ", flush=True)
    try:
        text = r.recognize_apple(audio_data)
        print(f"\u201c{text}\u201d")
        return text
    except sr.UnknownValueError:
        print("(could not understand audio)")
        return None
    except sr.RequestError as e:
        print(f"(recognition error: {e})")
        return None


def get_description_voice() -> str | None:
    """Capture a spoken description from the microphone."""
    audio = record_until_enter()
    if audio is None or len(audio) == 0:
        print("No audio recorded.", file=sys.stderr)
        return None
    return transcribe_audio(audio)


def get_description_text(prompt: str = "Describe the record: ") -> str | None:
    try:
        text = input(prompt).strip()
        return text or None
    except (EOFError, KeyboardInterrupt):
        return None


