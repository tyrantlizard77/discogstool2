#!/usr/bin/env python3
"""dt_server — Local HTTP bridge for the Discogs Label Printer Firefox extension.

Listens on localhost only. Accepts print/preview requests from the extension
and delegates to dt_label.

Usage:
    ./dt_server [--port PORT]

Default port: 5679 (configurable; must match the extension setting).
"""

import sys
import os
import json
import time
import atexit
import shutil
import argparse
import tempfile
import subprocess
import itertools
import collections
import glob
import queue
import threading

from flask import Flask, request, jsonify, send_from_directory

# ── Setup ─────────────────────────────────────────────────────────────────────

SCRIPT_DIR   = os.path.dirname(os.path.abspath(__file__))
DT_LABEL     = os.path.join(SCRIPT_DIR, "dt_label")
DEFAULT_PORT = 5679

app = Flask(__name__)

# Persistent directory for preview PNGs, served over HTTP.
# Cleared on each new preview request and on server exit.
PREVIEW_DIR = tempfile.mkdtemp(prefix="dt_label_previews_")
atexit.register(shutil.rmtree, PREVIEW_DIR, ignore_errors=True)

# ── Job queue and progress state ──────────────────────────────────────────────
# Print jobs run one at a time on a worker thread so concurrent extension
# requests cannot race each other at the printer.  POST /print returns as soon
# as the job is queued; the extension polls GET /progress to follow it.
#
# This is deliberately async: queue depth cannot exist otherwise.  Errors that
# used to ride back on the /print response now live on the job record, which is
# retained after failure so the UI can show what went wrong.

_PROGRESS_PREFIX = "@@DTP@@ "

# Stages in display order.  Keep in sync with dt_label.STAGES.
STAGES = ("lookup", "samples", "bpm", "render", "print")

# How many finished jobs to keep for display before discarding.
_HISTORY_LIMIT = 20

_job_queue   = queue.Queue()
_jobs        = collections.OrderedDict()   # job_id -> job dict
_jobs_lock   = threading.Lock()
_job_counter = itertools.count(1)


def _new_job(release_id, kind, **extra):
    """Create and register a job record."""
    job = {
        "id":         next(_job_counter),
        "release_id": release_id,
        "kind":       kind,             # "print" | "preview"
        "state":      "queued",         # queued | running | done | error
        "stages":     {s: {"state": "pending"} for s in STAGES},
        "title":      None,
        "error":      None,
        "created":    time.time(),
    }
    job.update(extra)
    with _jobs_lock:
        _jobs[job["id"]] = job
        # Trim the oldest finished jobs, keeping anything queued or running.
        finished = [j for j in _jobs.values() if j["state"] in ("done", "error")]
        for old in finished[:max(0, len(finished) - _HISTORY_LIMIT)]:
            _jobs.pop(old["id"], None)
    return job


def _apply_event(job, event):
    """Fold one dt_label progress event into a job record."""
    stage = event.get("stage")
    if stage not in job["stages"]:
        return
    entry = {"state": event.get("state", "pending")}
    for key in ("done", "total", "labels", "tracks", "message"):
        if key in event:
            entry[key] = event[key]
    job["stages"][stage] = entry
    if stage == "lookup" and event.get("title"):
        job["title"] = event["title"]
    if event.get("state") == "error":
        job["error"] = event.get("message") or "failed"


# Let the printer settle between jobs.  A completed send only means the printer
# has *accepted* the raster, not that the paper has stopped moving; starting the
# next job's raster immediately is what used to overrun its buffer.
_INTER_JOB_SETTLE_S = 2.0


def _print_worker():
    """Drain _job_queue one job at a time."""
    first = True
    while True:
        job = _job_queue.get()
        try:
            if not first and job.get("kind") == "print":
                time.sleep(_INTER_JOB_SETTLE_S)
            first = False
            _execute_job(job)
        except Exception as e:            # never let the worker die
            with _jobs_lock:
                job["state"] = "error"
                job["error"] = str(e)
            print(f"[dt_server] worker error on job {job['id']}: {e}",
                  file=sys.stderr)
        finally:
            _job_queue.task_done()


def _execute_job(job):
    """Run dt_label for one queued print job, streaming progress into `job`."""
    with _jobs_lock:
        job["state"]   = "running"
        job["started"] = time.time()

    rc, output = _run_dt_label(job["args"], job=job)

    with _jobs_lock:
        if rc == 0:
            job["state"] = "done"
        else:
            job["state"] = "error"
            # Prefer a stage-specific message captured from the event stream;
            # otherwise fall back to dt_label's own output, tail-trimmed so a
            # traceback doesn't end up in a desktop notification.
            if not job["error"]:
                tail = output.strip()[-400:]
                job["error"] = tail or f"dt_label exited {rc}"
            print(f"[dt_server] job {job['id']} (r{job['release_id']}) failed: "
                  f"{job['error']}", file=sys.stderr)
        job["finished"] = time.time()


def start_worker():
    """Start the background print worker.

    Called from main() rather than at import time so that importing dt_server
    (as the test suite does) does not spawn a thread that races the caller for
    queued jobs — or worse, launches real dt_label subprocesses.
    """
    threading.Thread(target=_print_worker, daemon=True,
                     name="print-worker").start()


# ── CORS ──────────────────────────────────────────────────────────────────────
# Only browser-extension origins are echoed back.  The server binds to
# localhost, but any page the user visits could otherwise POST to it, so the
# allowlist stays narrow: no wildcard, no http(s) origins.

_EXTENSION_ORIGINS = ("moz-extension://", "chrome-extension://")


def _is_extension_origin(origin):
    """True for a Firefox or Chrome extension origin."""
    return any(origin.startswith(scheme) for scheme in _EXTENSION_ORIGINS)


@app.after_request
def add_cors(response):
    origin = request.headers.get("Origin", "")
    if _is_extension_origin(origin):
        response.headers["Access-Control-Allow-Origin"]  = origin
        response.headers["Access-Control-Allow-Methods"] = "GET, POST, OPTIONS"
        response.headers["Access-Control-Allow-Headers"] = "Content-Type"
    return response

@app.route("/print",      methods=["OPTIONS"])
@app.route("/status",     methods=["OPTIONS"])
@app.route("/preview",    methods=["OPTIONS"])
@app.route("/progress",   methods=["OPTIONS"])
@app.route("/jobs/clear", methods=["OPTIONS"])
def preflight():
    return "", 204


# ── Endpoints ─────────────────────────────────────────────────────────────────

@app.route("/status", methods=["GET"])
def status():
    return jsonify({
        "ok":        True,
        "version":   "1.0",
        "discogs":   _check_discogs(),
        "beatport":  _check_beatport(),
        "anthropic": _check_anthropic(),
    })


def _check_service(fn):
    """Call fn(); translate ImportError → unavailable, other exceptions → error."""
    try:
        return fn()
    except ImportError:
        return {"status": "unavailable"}
    except Exception as e:
        return {"status": "error", "message": str(e)}


def _check_discogs():
    """Check whether Discogs OAuth tokens are stored and readable."""
    return _check_service(_do_check_discogs)


def _do_check_discogs():
    import client_interface
    token, secret = client_interface.get_user_auth_tokens()
    if token and secret:
        return {"status": "ok"}
    return {"status": "error", "message": "not authenticated"}


def _check_beatport():
    """Check Beatport credential health without making a full API call.

    Calls get_client(), which auto-refreshes the OAuth token if the stored
    username/password are still valid.  Returns a status dict.
    """
    return _check_service(_do_check_beatport)


def _do_check_beatport():
    import beatport
    beatport.get_client()
    return {"status": "ok"}


def _check_anthropic():
    """Check whether an Anthropic API key is configured."""
    return _check_service(_do_check_anthropic)


def _do_check_anthropic():
    """One key covers both consumers — the Beatport matcher and dt_find's
    record finder — so a single dot reports both."""
    import util
    if util.resolve_anthropic_key():
        return {"status": "ok"}
    return {"status": "error", "message": "no API key configured"}


@app.route("/preview/<path:filename>", methods=["GET"])
def serve_preview(filename):
    """Serve a previously generated preview PNG."""
    return send_from_directory(PREVIEW_DIR, filename)


@app.route("/print", methods=["POST"])
def print_label():
    data = request.get_json(force=True)

    release_id = str(data.get("release_id", "")).strip()
    profile    = str(data.get("profile", "dk1247")).strip()
    preview    = bool(data.get("preview", False))
    split      = bool(data.get("split", False))
    discs      = data.get("discs")   # list of ints or None
    no_bpm     = bool(data.get("hide_bpm", False))

    if not release_id.isdigit():
        return jsonify({"ok": False, "message": f"Invalid release ID: {release_id!r}"}), 400

    if preview:
        return _run_preview(release_id, profile, split=split, discs=discs, no_bpm=no_bpm)
    return _queue_print(release_id, profile, split=split, discs=discs, no_bpm=no_bpm)


@app.route("/progress", methods=["GET"])
def progress():
    """Current job stages, queue depth, and recently finished jobs.

    The extension polls this while the popup is open and, for the toolbar
    badge, while any job is active.
    """
    with _jobs_lock:
        jobs = list(_jobs.values())

    active  = [j for j in jobs if j["state"] == "running"]
    waiting = [j for j in jobs if j["state"] == "queued"]
    recent  = [j for j in jobs if j["state"] in ("done", "error")]
    recent.sort(key=lambda j: j.get("finished", 0), reverse=True)

    return jsonify({
        "ok":      True,
        "stages":  list(STAGES),
        "current": _public_job(active[0]) if active else None,
        "queued":  [_public_job(j) for j in waiting],
        "depth":   len(active) + len(waiting),
        "failures": sum(1 for j in recent if j["state"] == "error"),
        "recent":  [_public_job(j) for j in recent[:5]],
    })


@app.route("/jobs/clear", methods=["POST"])
def clear_jobs():
    """Drop finished/failed job history (clears the badge's error state)."""
    with _jobs_lock:
        for jid in [j["id"] for j in _jobs.values()
                    if j["state"] in ("done", "error")]:
            _jobs.pop(jid, None)
    return jsonify({"ok": True})


# ── Helpers ───────────────────────────────────────────────────────────────────

def _run_dt_label(args, *, job=None):
    """Run dt_label, streaming its output.

    Progress lines (prefixed with _PROGRESS_PREFIX) are folded into `job` as
    they arrive; everything else is accumulated and returned so a failure can
    be reported with real diagnostics.

    Returns (returncode, non-progress output).
    """
    cmd = [sys.executable, DT_LABEL] + (["--progress"] if job else []) + args
    proc = subprocess.Popen(
        cmd,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        bufsize=1,               # line buffered, so progress arrives promptly
        cwd=SCRIPT_DIR,
    )

    lines = []
    for line in proc.stdout:
        if job is not None and line.startswith(_PROGRESS_PREFIX):
            try:
                event = json.loads(line[len(_PROGRESS_PREFIX):])
            except ValueError:
                continue
            with _jobs_lock:
                _apply_event(job, event)
        else:
            lines.append(line)

    proc.wait()
    return proc.returncode, "".join(lines)


def _split_args(split, discs):
    """Build --split / --discs argument fragments."""
    args = []
    if split:
        args.append("--split")
    if split and discs:
        args += ["--discs"] + [str(d) for d in discs]
    return args


def _bpm_args(no_bpm):
    """Build --no-bpm argument fragment."""
    return ["--no-bpm"] if no_bpm else []


def _queue_print(release_id, profile, split=False, discs=None, no_bpm=False):
    """Enqueue a print job and return immediately with its id and queue depth."""
    job = _new_job(release_id, "print")
    job["args"] = (["--label-profile", profile] + _split_args(split, discs)
                   + _bpm_args(no_bpm) + ["--", release_id])
    _job_queue.put(job)
    return jsonify({
        "ok":     True,
        "job_id": job["id"],
        "queued": _queue_depth(),
    })


def _run_preview(release_id, profile, split=False, discs=None, no_bpm=False):
    """Render previews synchronously — no printer involved, so no queueing.

    Still reported as a job so the popup can show stage progress while its
    own request is in flight (Flask serves other requests on separate threads).
    """
    # Clear any previous previews
    for old in glob.glob(os.path.join(PREVIEW_DIR, "*.png")):
        try:
            os.remove(old)
        except OSError:
            pass

    job = _new_job(release_id, "preview")
    with _jobs_lock:
        job["state"] = "running"

    rc, output = _run_dt_label([
        "--preview",
        "--label-profile", profile,
        "--output", PREVIEW_DIR,
    ] + _split_args(split, discs) + _bpm_args(no_bpm) + ["--", release_id], job=job)

    with _jobs_lock:
        job["finished"] = time.time()
        if rc != 0:
            job["state"] = "error"
            if not job["error"]:
                job["error"] = output.strip() or f"dt_label exited {rc}"
        else:
            job["state"] = "done"

    if rc != 0:
        return jsonify({"ok": False, "message": job["error"]}), 500

    pngs = sorted(glob.glob(os.path.join(PREVIEW_DIR, "*.png")))
    if not pngs:
        return jsonify({"ok": False, "message": "dt_label produced no PNG"}), 500

    urls = [f"/preview/{os.path.basename(p)}" for p in pngs]
    return jsonify({"ok": True, "preview_urls": urls, "job_id": job["id"]})


def _queue_depth():
    """Number of jobs waiting or in flight."""
    with _jobs_lock:
        return sum(1 for j in _jobs.values()
                   if j["state"] in ("queued", "running"))


def _public_job(job):
    """Strip internal fields before sending a job over HTTP."""
    return {k: v for k, v in job.items() if k != "args"}


# ── Entry point ───────────────────────────────────────────────────────────────

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--port", type=int, default=DEFAULT_PORT,
                        help=f"Port to listen on (default: {DEFAULT_PORT})")
    args = parser.parse_args()

    start_worker()

    print(f"dt_server listening on http://localhost:{args.port}")
    print("Press Ctrl-C to stop.")

    app.run(host="127.0.0.1", port=args.port, debug=False)


if __name__ == "__main__":
    main()
